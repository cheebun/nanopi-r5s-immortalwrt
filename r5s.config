# FriendlyElec NanoPi R5S (RK3568) - ImmortalWrt master (kernel 6.18) diffconfig
#
# Seed for `make defconfig`; see README.md "Configuration". Lines here win over
# upstream defaults. scripts/check-config.sh enforces the result after
# `make defconfig` and after the build, so keep both files in sync.

# --- Target / profile -------------------------------------------------------
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y

# --- Kernel: BTF debug info -------------------------------------------------
# Upstream only defaults BTF on for BUILDBOT builds (config/Config-kernel.in),
# so a local or CI build must ask for it. BTF selects host dwarves (pahole).
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y

# --- Kernel: netkit and BPF features (honk / dae runtime) -------------------
# netkit is a built-in kernel option (CONFIG_NETKIT); there is no kmod-netkit.
CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
# Optional for honk: the native-api UDP receive-trace fallback attaches
# fentry/fexit programs and needs ftrace. Dynamic ftrace is patched to NOPs
# when unused.
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y

# --- Kernel modules ---------------------------------------------------------
# Spec items.
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
# honk runtime. honk itself is not built here: it is installed on the router
# from daeuniverse's official releases. Official kmods cannot be installed on
# this custom kernel (vermagic differs), so every kmod honk depends on must
# already be in the image (honk/Makefile in daeuniverse/openwrt-packages).
# kmod-sched-core also flips CONFIG_NET_SCHED/NET_CLS_ACT=y, which selects
# CONFIG_NET_XGRESS (TCX). scripts/check-config.sh checks the whole list
# (HONK_RUNTIME_REQUIRED), including the spec kmods above.
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
# Userspace honk dependency; small, preinstalled so honk installs offline.
# v2ray-geoip / v2ray-geosite (also honk deps) are in the image for mosdns.
CONFIG_PACKAGE_libstdcpp=y
# luci-lib-daeuniverse (pulled in by luci-app-honk) depends on flock
# (util-linux, main tree) and coreutils-timeout (packages feed).
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_coreutils-timeout=y

# --- ImmortalWrt "tweak" packages -------------------------------------------
# Release branches add DEFAULT_PACKAGES.tweak (include/target.mk) to every
# image; master leaves that line commented out, so a master build has no LuCI
# and no autocore unless they are selected here. Same list as the release.
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-cpufreq=y

# --- LuCI theme: Vantage ----------------------------------------------------
# anothaDev's Vantage theme, its dashboard and the per-device traffic add-on,
# from the vantage feed (feeds.conf.extra, pinned to v1.2.0), with their
# zh-cn translations. files/etc/uci-defaults/99-vantage makes Vantage the
# LuCI theme. Bootstrap stays as the fallback theme. The access-point pairing
# add-on (luci-app-vantage-aps) and Argon are not wanted; check-config.sh
# fails if any of them is selected.
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
CONFIG_PACKAGE_luci-app-vantage-traffic=y
CONFIG_PACKAGE_luci-i18n-vantage-traffic-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-app-vantage-aps is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# --- Userspace additions ----------------------------------------------------
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_chrony=y
# chrony-nts is the NTS-capable variant; not wanted.
# CONFIG_PACKAGE_chrony-nts is not set
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-i18n-chrony-zh-cn=y

# --- DNS: dnsmasq-full + sbwml mosdns ---------------------------------------
# mosdns, luci-app-mosdns and geo2txt come from sbwml's feed
# (feeds.conf.extra); scripts/prepare-feeds.sh removes the packages feed's
# mosdns so it cannot shadow sbwml's. No mosdns configuration is shipped.
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
CONFIG_PACKAGE_geo2txt=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# --- OpenSSL with the built-in devcrypto engine -----------------------------
# DEVCRYPTO pulls kmod-cryptodev and libopenssl-conf via package deps.
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_ENGINE_BUILTIN=y
CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO=y
CONFIG_PACKAGE_kmod-cryptodev=y

# --- Time sync: chrony replaces busybox ntpd / sysntpd ----------------------
# BUSYBOX_CONFIG_* is only honoured with BUSYBOX_CUSTOM=y; without it busybox
# uses BUSYBOX_DEFAULT_NTPD=y and installs /etc/init.d/sysntpd regardless.
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_BUSYBOX_CONFIG_NTPD is not set
# CONFIG_BUSYBOX_CONFIG_FEATURE_NTPD_SERVER is not set

# --- Removed ----------------------------------------------------------------
# None of these is in the ImmortalWrt default image; they are pinned off so a
# future upstream default or a stray dependency cannot bring them back.
# Symbols for packages absent from the feeds (lucky, pushbot) are dropped by
# `make defconfig` and only enforced by scripts/check-config.sh.
# DDNS
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts-utils is not set
# CONFIG_PACKAGE_ddns-scripts-cloudflare is not set
# CONFIG_PACKAGE_ddns-scripts-aliyun is not set
# CONFIG_PACKAGE_ddns-scripts-dnspod is not set
# CONFIG_PACKAGE_ddns-scripts-dnspod-com is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# DDNS-Go
# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set
# Lucky (third-party feed only)
# CONFIG_PACKAGE_lucky is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-i18n-lucky-zh-cn is not set
# ZeroTier
# CONFIG_PACKAGE_zerotier is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn is not set
# WeChatPush (LuCI app only, no separate backend package)
# CONFIG_PACKAGE_luci-app-wechatpush is not set
# CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn is not set
# PushBot (third-party feed only)
# CONFIG_PACKAGE_luci-app-pushbot is not set
# CONFIG_PACKAGE_luci-i18n-pushbot-zh-cn is not set
# vlmcsd
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set
# Attended sysupgrade would replace this custom image with a stock one.
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_owut is not set
